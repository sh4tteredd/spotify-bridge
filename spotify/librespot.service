[Unit]
Description=librespot — Spotify Connect verso la FIFO PCM
After=network-online.target spotify-cast.service
Wants=network-online.target
Requires=spotify-cast.service

[Service]
Type=simple
WorkingDirectory=/opt/spotify-bridge/spotify
ExecStart=/usr/local/bin/librespot -n "Cucina Audio" -B subprocess -d /opt/spotify-bridge/spotify/fifo_writer.sh -b 320 --cache /var/cache/librespot
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target

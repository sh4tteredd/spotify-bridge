<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  Pubblica il Nest Hub (che non ha responder mDNS) come device Google Cast.
  Installare in /etc/avahi/services/googlecast.service e riavviare avahi-daemon.

  I valori TXT sono quelli reali letti da /setup/eureka_info e dal certificato
  Cast del device; il target SRV e' l'hostname di questo Raspberry, quindi i
  sender si connetteranno al Pi e il relay inoltrera' a 192.168.178.124:8009.
-->
<service-group>
  <name replace-wildcards="no">Google-Nest-Hub-b36c4e25d986c668</name>
  <service>
    <type>_googlecast._tcp</type>
    <port>8009</port>
    <txt-record>id=b36c4e25d986c66848451124a6fc27a9</txt-record>
    <txt-record>cd=B36C4E25D986C66848451124A6FC27A9</txt-record>
    <txt-record>rm=</txt-record>
    <txt-record>ve=05</txt-record>
    <txt-record>md=Google Nest Hub</txt-record>
    <txt-record>ic=/setup/icon.png</txt-record>
    <txt-record>fn=Cucina Display</txt-record>
    <txt-record>ca=199172</txt-record>
    <txt-record>st=0</txt-record>
    <txt-record>bs=FA8FCA779A57</txt-record>
    <txt-record>nf=1</txt-record>
    <txt-record>rs=</txt-record>
  </service>
</service-group>
